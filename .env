# Shared local-development settings for every plugin (each vite.config.ts sets
# envDir to this folder). Only read when running `npm run dev`: the code uses
# these values only when import.meta.env.DEV is true, so production builds for
# APEX never contain them.
#
# Real values go in .env.local next to this file (git-ignored); Vite loads it
# on top of this one. Never put real credentials in this committed file.
#
# TEMPORARY: committed for convenience; remove before go-live.

# Bearer token used when running outside APEX. Tokens last about 1 hour; get a
# fresh one from POST {api_endpoint}/oauth/token with
# grant_type=client_credentials and set it in .env.local.
VITE_DEV_ACCESS_TOKEN=sample-access-token-replace-me

# base64("<client id>:<client secret>") for the token endpoint's
# Authorization: Basic header. Only FIN_EVAL/MnA and MnA_Buy_Plan use it, to
# mint tokens themselves in local dev. Set the real value in .env.local.
VITE_DEV_BASIC_AUTH=base64-of-client-id-colon-client-secret
